[Unit]
Description=dream launcher — claim one topic and spawn it as a detached per-dream unit
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# %h/.npm-global/bin: npm/npx/claude; %h/.local/bin: dream + uvx
Environment=PATH=%h/.npm-global/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=%h/.local/bin/dream run
# This unit only seeds/reaps/gates/claims and systemd-run's the actual dream as
# its own transient unit (dream-<campaign>-<nnn>.service), then exits — that is
# what lets dreams OVERLAP: an hourly fire is never merged away behind a
# still-running 2-3h dream, and memory containment (MemoryMax=5G) rides on each
# per-dream transient unit, not on this launcher.
TimeoutStartSec=600

[Install]
WantedBy=default.target
