#!/usr/bin/env bash
# dream — unattended research-dream campaign runner.
#
# Runs ONE dream per qualifying invocation via `claude -p`: claim the next topic
# from the campaign queue, render its prompt, dispatch a jailed headless agent
# against the campaign's target repo, record the result, ping Discord. The
# engine lives here (+ ~/.local/lib/dream/); everything campaign-specific —
# topics, prompt template, target repo, accounts — lives in
# ~/.config/dream/campaigns/<name>/ (stowed from furn-config). Mutable state
# (queue, interval, logs) lives in ~/.local/state/dream/<name>/.
#
# Cadence has exactly one rule and it lives in the queue, not in systemd: the
# dream.timer fires `dream run` HOURLY, and the gate runs a dream only when the
# configured interval has elapsed since the last dream STARTED. Change cadence
# with `dream interval N` — never by editing units.
#
# Accounts: timer-driven dreams alternate strictly over campaign.json's account
# list (parity recomputed from committed queue state — deterministic and
# reboot-safe). `dream loop`/`dream once --account X` force one account, e.g. to
# burn down a quota:  dream loop --account sebbe --every 1h
# (inside tmux; Ctrl-C to stop, then `dream install` to hand over to the timer.
# On a workstation wrap it in `systemd-inhibit --what=sleep:idle` so the box
# stays awake; a headless server never sleeps and its polkit may deny inhibits).
#
# Strictly sequential: one dream at a time, ever — a flock in the state dir
# guards every dispatch path (timer and loop can coexist; the late one yields).
#
# No retries by design: a failed or empty dream still marks its topic done and
# the campaign moves on — this is a scan, not a guaranteed-yield job.
set -uo pipefail

CAMPAIGN="halvex"
if [[ "${1:-}" == "--campaign" ]]; then
  [[ $# -ge 2 ]] || { echo "--campaign needs a value" >&2; exit 2; }
  CAMPAIGN="$2"; shift 2
fi

LIB="$HOME/.local/lib/dream"
CONFIG="$HOME/.config/dream/campaigns/$CAMPAIGN"
STATE="$HOME/.local/state/dream/$CAMPAIGN"
LOGS="$STATE/logs"
QUEUE=(python3 "$LIB/queue.py" "$CAMPAIGN")

usage() {
  cat <<EOF
usage: dream [--campaign NAME] <command>

  run [--force]              one qualifying dream (the timer's entry point):
                             seed if needed, interval gate (--force skips it),
                             then claim/dispatch/finalize/ping
  once [--account A]         one dream NOW, gate skipped (rotation unless --account)
  loop --account A [--every 1h]
                             foreground burn: one dream per interval on ONE
                             account until drained or Ctrl-C (run inside tmux,
                             under systemd-inhibit --what=sleep:idle)
  status                     campaign progress
  interval [N[h]]            print or set the run interval in hours
  target [PATH]              print or set THIS machine's target repo checkout
                             (e.g. /srv/halvex/apps/data-pipeline on peppar)
  prompt                     render the NEXT topic's prompt (claims nothing)
  install | uninstall        enable / disable the hourly dream.timer (user unit)
EOF
}

[[ $# -ge 1 ]] || { usage >&2; exit 2; }
CMD="$1"; shift

[[ -f "$CONFIG/campaign.json" ]] || { echo "dream: no campaign '$CAMPAIGN' at $CONFIG" >&2; exit 1; }
mkdir -p "$STATE" "$LOGS"

cfg() { python3 -c "import json,sys;print(json.load(open('$CONFIG/campaign.json'))['$1'])"; }
jget() { python3 -c "import json,sys;v=json.load(sys.stdin).get(\"$1\");print('' if v is None else v)"; }

# Resolved by queue.py: env DREAM_TARGET > per-machine state (`dream target
# PATH`) > campaign.json default. One resolver, used by CLI and queue alike.
# NOT validated here — `dream target` must work on a machine whose default
# path doesn't exist; run_one checks before dispatching.
TARGET="$("${QUEUE[@]}" target | jget target)"
SCRATCH_DREAMS="$TARGET/$(cfg scratch_dir)"
WRITE_ROOT="$TARGET/$(cfg write_root)"
MODEL="$(cfg model)"
TIMEOUT_S="$(cfg timeout_seconds)"
ENV_FILE="$TARGET/$(cfg env_file)"

RUN_LOG="$LOGS/dream.log"
write_log() { printf '[%s] %s\n' "$(date -Iseconds)" "$1" | tee -a "$RUN_LOG"; }

# --- Discord (dreams channel only; silently skipped when the webhook is unset,
# so the campaign never leaks into other channels) ---------------------------
dreams_webhook() {
  if [[ -n "${DISCORD_DREAMS_WEBHOOK_URL:-}" ]]; then
    printf '%s' "$DISCORD_DREAMS_WEBHOOK_URL"
  elif [[ -f "$ENV_FILE" ]]; then
    sed -n 's/^[[:space:]]*DISCORD_DREAMS_WEBHOOK_URL=//p' "$ENV_FILE" | tail -1
  fi
}
ping_dreams() {
  local url; url="$(dreams_webhook)"
  [[ -n "$url" ]] || return 0
  local msg="$1"
  if (( ${#msg} > 1900 )); then msg="${msg:0:1900}…"; fi
  local body
  body=$(python3 -c 'import json,sys;print(json.dumps({"content": sys.stdin.read()}))' <<< "$msg")
  curl -sS -m 15 -X POST -H "Content-Type: application/json" -d "$body" "$url" \
    >/dev/null 2>&1 || echo "[discord] dream ping failed" >&2
}

# --- Account + binary resolution --------------------------------------------
# Named account => ~/.claude-<name>, no exceptions (see furn-config accounts
# manifest). Refusing to guess is the point: a dispatch under an
# unauthenticated config would burn a topic on an instant failure.
resolve_account_dir() {
  local dir="$HOME/.claude-$1"
  [[ -f "$dir/.credentials.json" ]] && printf '%s' "$dir"
}
# `claude` on PATH is normally a per-account wrapper that would override the
# CLAUDE_CONFIG_DIR resolved above — use the first claude OUTSIDE the wrapper
# dir (the real binary).
claude_bin() {
  local p
  while IFS= read -r p; do
    case "$p" in "$HOME/.local/claude-bin/"*) continue ;; esac
    printf '%s' "$p"; return 0
  done < <(bash -c 'type -ap claude')
  return 1
}

# --- One dream: claim → render → dispatch → finalize → ping -----------------
# $1 = forced account name, or "" for rotation. Returns 0 unless dispatch was
# impossible; sets DRAINED=1 when the queue is empty.
DRAINED=0
run_one() {
  local forced="$1" select_args=()
  [[ -n "$forced" ]] && select_args=(--account "$forced")

  if [[ ! -d "$TARGET" ]]; then
    write_log "FATAL: target checkout not found: $TARGET — set it for this machine with: dream target /path/to/halvex/apps/data-pipeline"
    return 1
  fi

  local selection
  selection=$("${QUEUE[@]}" select "${select_args[@]}")
  if [[ -z "$selection" ]]; then write_log "queue select produced no output — aborting"; return 1; fi
  if [[ "$(printf '%s' "$selection" | jget drained)" == "True" ]]; then DRAINED=1; return 0; fi

  local index nnn slug title family_name hint account session_id
  index=$(printf '%s' "$selection" | jget index)
  nnn=$(printf '%s' "$selection" | jget nnn)
  slug=$(printf '%s' "$selection" | jget slug)
  title=$(printf '%s' "$selection" | jget title)
  family_name=$(printf '%s' "$selection" | jget family_name)
  hint=$(printf '%s' "$selection" | jget hint)
  account=$(printf '%s' "$selection" | jget account)
  session_id=$(printf '%s' "$selection" | jget session_id)
  [[ -n "$hint" ]] || hint="none recorded — find the mapping yourself"

  local config_dir
  if ! config_dir="$(resolve_account_dir "$account")" || [[ -z "$config_dir" ]]; then
    write_log "FATAL: no logged-in config dir for account '$account' (looked in $HOME/.claude-$account)"
    ping_dreams ":rotating_light: **Dream $nnn skipped** — account \`$account\` has no logged-in Claude config on $(hostname). Run \`claude\` once under that account, then re-fire."
    "${QUEUE[@]}" finalize "$index" 78 >> "$RUN_LOG" 2>&1
    return 1
  fi
  local bin
  if ! bin="$(claude_bin)"; then write_log "FATAL: no claude binary on PATH outside ~/.local/claude-bin"; return 1; fi

  write_log "=== dream $nnn/$slug — account=$account, config=$config_dir, session=$session_id ==="

  mkdir -p "$SCRATCH_DREAMS"
  local prompt_file="$SCRATCH_DREAMS/$nnn.prompt.md"
  python3 "$LIB/render-prompt.py" "$CONFIG/prompt.tmpl.md" \
      "INDEX=$index" "NNN=$nnn" "SLUG=$slug" "FAMILY_NAME=$family_name" \
      "DATE=$(date +%Y-%m-%d)" "SCRATCH_DREAMS=$SCRATCH_DREAMS" \
      "TITLE=$title" "HINT=$hint" > "$prompt_file"

  # The write-jail hook is the dream's only write authority.
  local settings
  settings=$(python3 - "$LIB/write-jail.py" <<'PY'
import json, sys
hook = sys.argv[1]
print(json.dumps({
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
                "hooks": [{"type": "command", "command": f"python3 {hook}"}],
            }
        ]
    }
}))
PY
)

  local dream_log="$LOGS/$nnn-$slug.log" started_s rc=0
  started_s=$(date +%s)
  if ! ( cd "$TARGET" && \
         DREAM_TARGET="$TARGET" DREAM_WRITE_ROOT="$WRITE_ROOT" \
         CLAUDE_CONFIG_DIR="$config_dir" CLAUDE_ACCOUNT="$account" \
         timeout --foreground --kill-after=30 "${TIMEOUT_S}s" \
           "$bin" -p "$(cat "$prompt_file")" \
             --model "$MODEL" \
             --dangerously-skip-permissions \
             --settings "$settings" \
             --session-id "$session_id" \
             >> "$dream_log" 2>&1 ); then
    rc=$?
  fi
  write_log "dream $nnn/$slug finished: exit=$rc in $(( $(date +%s) - started_s ))s"

  local summary artifact_url idea n_better n_worse n_finds
  summary=$("${QUEUE[@]}" finalize "$index" "$rc")
  artifact_url=$(printf '%s' "$summary" | jget artifact_url)
  idea=$(printf '%s' "$summary" | jget idea)
  n_better=$(printf '%s' "$summary" | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("better") or []))')
  n_worse=$(printf '%s' "$summary" | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("worse") or []))')
  n_finds=$(printf '%s' "$summary" | python3 -c 'import json,sys;print(len(json.load(sys.stdin).get("finds") or []))')
  [[ "$(printf '%s' "$summary" | jget all_done)" == "True" ]] && DRAINED=1

  if [[ -n "$artifact_url" ]]; then
    ping_dreams ":thought_balloon: **Dream $nnn — $title**
_${idea}_
Better at: ${n_better} · Worse at: ${n_worse} · Finds: ${n_finds} · account: ${account}
$artifact_url"
  else
    ping_dreams ":thought_balloon: **Dream $nnn — $title** (account: ${account}) produced no artifact (exit=$rc). See \`$dream_log\`."
  fi
  return 0
}

campaign_complete() {
  write_log "queue drained — campaign complete; disabling dream.timer (auto-stop)"
  ping_dreams ":checkered_flag: **Dream campaign complete** — every dream has run. Scan the dreams scratch dir + queue.json."
  systemctl --user disable --now dream.timer >> "$RUN_LOG" 2>&1 || \
    write_log "could not disable dream.timer (not fatal; it will just no-op each fire)"
}

take_lock() {
  exec 9>"$STATE/.dream.lock"
  if ! flock -n 9; then
    write_log "a dream is still running — this invocation yields (nothing claimed)"
    return 1
  fi
}

parse_duration_s() {  # 1h / 90m / 3600 → seconds
  local v="$1"
  case "$v" in
    *h) echo $(( ${v%h} * 3600 )) ;;
    *m) echo $(( ${v%m} * 60 )) ;;
    *)  echo "$v" ;;
  esac
}

case "$CMD" in
  run)
    FORCE=0
    [[ "${1:-}" == "--force" ]] && FORCE=1
    "${QUEUE[@]}" seed >> "$RUN_LOG" 2>&1
    if [[ "$FORCE" != "1" ]]; then
      gate=$("${QUEUE[@]}" gate)
      if [[ "$(printf '%s' "$gate" | jget fire)" != "True" ]]; then
        write_log "interval gate: skipping this fire ($gate)"
        exit 0
      fi
    fi
    take_lock || exit 0
    run_one "" || exit 1
    [[ "$DRAINED" == "1" ]] && campaign_complete
    ;;
  once)
    ACCOUNT=""
    [[ "${1:-}" == "--account" ]] && { ACCOUNT="${2:?--account needs a value}"; }
    "${QUEUE[@]}" seed >> "$RUN_LOG" 2>&1
    take_lock || exit 1
    run_one "$ACCOUNT" || exit 1
    [[ "$DRAINED" == "1" ]] && echo "queue drained — campaign complete"
    ;;
  loop)
    ACCOUNT="" EVERY="1h"
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --account) ACCOUNT="${2:?--account needs a value}"; shift 2 ;;
        --every)   EVERY="${2:?--every needs a value}"; shift 2 ;;
        *) echo "unknown loop flag: $1" >&2; exit 2 ;;
      esac
    done
    [[ -n "$ACCOUNT" ]] || { echo "dream loop: --account is required (this mode exists to burn ONE account)" >&2; exit 2; }
    EVERY_S=$(parse_duration_s "$EVERY")
    "${QUEUE[@]}" seed >> "$RUN_LOG" 2>&1
    write_log "loop: one dream every $EVERY on account '$ACCOUNT' until drained or Ctrl-C"
    while :; do
      t0=$(date +%s)
      if take_lock; then
        run_one "$ACCOUNT" || { write_log "loop: dispatch failed — stopping (fix and rerun)"; exit 1; }
        exec 9>&-
      fi
      if [[ "$DRAINED" == "1" ]]; then campaign_complete; break; fi
      left=$(( EVERY_S - ($(date +%s) - t0) ))
      if (( left > 0 )); then
        write_log "loop: next dream in ${left}s"
        sleep "$left"
      fi
    done
    ;;
  status)
    "${QUEUE[@]}" seed > /dev/null 2>&1
    "${QUEUE[@]}" status
    ;;
  interval)
    if [[ $# -ge 1 ]]; then "${QUEUE[@]}" interval "${1%h}"; else "${QUEUE[@]}" interval; fi
    ;;
  target)
    if [[ $# -ge 1 ]]; then "${QUEUE[@]}" target "$1"; else "${QUEUE[@]}" target; fi
    ;;
  prompt)
    "${QUEUE[@]}" seed > /dev/null 2>&1
    peek=$("${QUEUE[@]}" peek)
    if [[ "$(printf '%s' "$peek" | jget drained)" == "True" ]]; then
      echo "queue drained — no pending topic to render"; exit 0
    fi
    hint=$(printf '%s' "$peek" | jget hint)
    [[ -n "$hint" ]] || hint="none recorded — find the mapping yourself"
    echo "# would run topic $(printf '%s' "$peek" | jget index) ($(printf '%s' "$peek" | jget slug)) on account: $(printf '%s' "$peek" | jget account)" >&2
    python3 "$LIB/render-prompt.py" "$CONFIG/prompt.tmpl.md" \
        "INDEX=$(printf '%s' "$peek" | jget index)" "NNN=$(printf '%s' "$peek" | jget nnn)" \
        "SLUG=$(printf '%s' "$peek" | jget slug)" "FAMILY_NAME=$(printf '%s' "$peek" | jget family_name)" \
        "DATE=$(date +%Y-%m-%d)" "SCRATCH_DREAMS=$SCRATCH_DREAMS" \
        "TITLE=$(printf '%s' "$peek" | jget title)" "HINT=$hint"
    ;;
  install)
    systemctl --user daemon-reload
    systemctl --user enable --now dream.timer
    systemctl --user list-timers dream.timer --no-pager || true
    ;;
  uninstall)
    systemctl --user disable --now dream.timer
    ;;
  -h|--help|help) usage ;;
  *) echo "dream: unknown command '$CMD'" >&2; usage >&2; exit 2 ;;
esac
