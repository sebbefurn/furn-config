# ~/.gitconfig — managed by furn-config (stow git)
[user]
	name = Sebastian Furn
	email = sebastian.furn@gmail.com
	signingkey = ~/.ssh/id_ed25519.pub
[init]
	defaultBranch = main
[pull]
	rebase = true
[rebase]
	autostash = true
	autosquash = true
[push]
	autoSetupRemote = true
	default = simple
[fetch]
	prune = true
[merge]
	conflictstyle = zdiff3
[diff]
	algorithm = histogram
	colorMoved = default
[core]
	editor = vim
	pager = less -FRX
[color]
	ui = auto
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = ~/.config/git/allowed_signers
[url "git@github.com:"]
	insteadOf = https://github.com/
[alias]
	st = status -sb
	co = checkout
	br = branch
	ci = commit
	df = diff
	dc = diff --cached
	last = log -1 HEAD
	unstage = reset HEAD --
	amend = commit --amend --no-edit
	ll = log --oneline --graph --decorate -20
	lg = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) %C(dim white)%an%C(reset)%C(auto)%d%C(reset) %s %C(dim green)(%ar)%C(reset)'
	aliases = config --get-regexp ^alias\\.
