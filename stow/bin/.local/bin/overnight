#!/usr/bin/env bash
# overnight — unattended sequential issue runner (rolling handoff chains).
#
# Runs a CHAIN of Claude agents per GitHub issue in the current project. Each
# agent ("link") either finishes the issue or winds down gracefully: past the
# soft deadline a PostToolUse hook nags it after every tool call to commit
# wip(#N) checkpoints, write a handoff note, and exit cleanly; a fresh
# successor then picks up the handoff (plus the issue and git as ground truth).
# The hard kill is a rarely-fired backstop, not the routine ending. Completion
# is gated on: issue CLOSED, clean tracked tree, type-check, tests. A chain
# halts on MAX_ATTEMPTS CONSECUTIVE failed links (the counter resets on every
# successful handoff), on the per-issue wall-clock budget (a launch gate — the
# last link may overshoot), or on two consecutive fast failures (systemic:
# out of tokens, auth, environment). Everything is preserved for review.
#
# Operates on the CURRENT WORKING DIRECTORY (must be a git repo with a
# package.json). Launch with:
#   systemd-inhibit --what=sleep:idle overnight --account sebastian 327-334
# (inside tmux).
#
# --account picks the Claude account the agents spend, by name from
# ~/.config/claude/accounts (see usage below). There is no default: agents
# would otherwise quietly bill whatever account happened to be ambient.
set -u

# ---- Chain tuning ----
SOFT_DEADLINE_MIN=45  # nag stage 1 begins: finish only if imminent, else hand off
ESCALATION_MIN=60     # nag stage 2 begins: hand off NOW, no finishing
HARD_KILL_MIN=80      # per-link hard kill — backstop for agents that ignore the nags
ISSUE_BUDGET_MIN=240  # per-issue wall clock; a LAUNCH GATE only (last link may overshoot)
MAX_ATTEMPTS=5        # consecutive failed links halt the issue; resets on handoff/close
FAST_FAIL_SECS=120    # two consecutive failures faster than this => systemic halt

# Headless (`claude -p`) keeps waiting for background subagents after the model
# ends its turn, up to this ceiling, before terminating the session. The default
# is 600s (10m); a fan-out of test-file subagents can need longer, and being
# killed mid-wait strands the run — the agent never re-wakes to run the final
# suite/commit/close, so the issue is left OPEN with work uncommitted. 15 minutes.
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=900000

usage() {
  cat <<EOF
usage: overnight --account <name> [--human] <issue|start-end> [...]

Each positional argument is a single issue number or an inclusive range
(end >= start). Any mix is allowed; the queue runs in the order given,
ranges ascending.

--account selects which Claude account the agents spend, by account name
from the ~/.config/claude/accounts manifest (config dir ~/.claude-<name>).
It is required unless CLAUDE_CONFIG_DIR is already set in the environment,
in which case that dir is inherited. The resolved account's email is
logged at pre-flight, before any agent runs.

By default agents run fully autonomously: they never stop to ask for human
input or leave an issue OPEN pending a decision. On any ambiguity they read
the related and linked issues, infer the philosophy those express, and pick
the best-fitting solution themselves. With --human, an agent that is
genuinely blocked may instead post a comment and leave the issue OPEN for
review, which halts the queue.

Each issue is worked by a CHAIN of agents. A link works until it finishes
or winds down: from ${SOFT_DEADLINE_MIN}m a hook nags it after every tool call to commit
wip(#N) checkpoints, write a handoff note, and exit cleanly (from ${ESCALATION_MIN}m the
nag forbids finishing); a fresh successor picks up the handoff. Handoffs
are success and cost nothing. The ${HARD_KILL_MIN}m hard kill is a backstop for links
that ignore the nags. A chain halts on ${MAX_ATTEMPTS} CONSECUTIVE failed links
(crash, hard kill, red gates — counter resets on every clean handoff), on
the ${ISSUE_BUDGET_MIN}m per-issue budget (checked before each launch; the last link may
overshoot), or on two consecutive sub-${FAST_FAIL_SECS}s failures (systemic: out of
tokens, auth, environment — not the issue's fault).

Issue completion is gated on: issue CLOSED, clean tracked tree, green
\`npm run type-check\` + \`npm test\`. Mid-chain wip commits are NOT gated.

examples:
  overnight --account sebastian 327-334
  overnight --account sebbe --human 1 2 4 10
  overnight --account sebastian 4-6 8-15 17 20-21

Runs against the current directory: pre-flight requires a git repo with
package.json, gh auth, claude on PATH, a logged-in account config dir, all
issues OPEN, a clean tracked tree, and green \`npm run type-check\` +
\`npm test\` before any agent starts.
Logs and handoff notes land in ~/.local/state/overnight/<dir-name>/<timestamp>/.
EOF
}

usage_die() { printf 'overnight: %s\n\n' "$*" >&2; usage >&2; exit 2; }

# ---- Argument parsing (no side effects until args are fully valid) ----
[ $# -gt 0 ] || usage_die "no issues specified"

ACCOUNT=""
HUMAN=0
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --account)
      [ $# -ge 2 ] || usage_die "--account needs a value (an account name from ~/.config/claude/accounts)"
      ACCOUNT="$2"; shift 2 ;;
    --account=*) ACCOUNT="${1#*=}"; shift ;;
    --human) HUMAN=1; shift ;;
    -*) usage_die "unknown option '$1'" ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

# Account -> config dir. Explicit flag (validated against the manifest) wins;
# otherwise inherit an already-set CLAUDE_CONFIG_DIR; otherwise refuse rather
# than silently spend an account.
ACCOUNTS_FILE="$HOME/.config/claude/accounts"
known_accounts() { awk '!/^([[:space:]]*(#|$))/ { print $2 }' "$ACCOUNTS_FILE" 2>/dev/null; }

if [ -n "$ACCOUNT" ]; then
  known_accounts | grep -qx -- "$ACCOUNT" \
    || usage_die "unknown account '$ACCOUNT' (known, from $ACCOUNTS_FILE: $(known_accounts | paste -sd' ' -))"
  export CLAUDE_CONFIG_DIR="$HOME/.claude-$ACCOUNT"
  CONFIG_DESC="$CLAUDE_CONFIG_DIR"
else
  [ -n "${CLAUDE_CONFIG_DIR:-}" ] \
    || usage_die "no account selected: pass --account <name> (known, from $ACCOUNTS_FILE: $(known_accounts | paste -sd' ' -))"
  export CLAUDE_CONFIG_DIR
  CONFIG_DESC="$CLAUDE_CONFIG_DIR (inherited)"
fi
CONFIG_JSON="$CLAUDE_CONFIG_DIR/.claude.json"

[ ${#POSITIONAL[@]} -gt 0 ] || usage_die "no issues specified"

ISSUES=()
declare -A seen=()
for arg in "${POSITIONAL[@]}"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    lo=$((10#$arg)) hi=$((10#$arg))
  elif [[ "$arg" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    lo=$((10#${BASH_REMATCH[1]})) hi=$((10#${BASH_REMATCH[2]}))
    [ "$hi" -ge "$lo" ] || usage_die "range '$arg': end must be >= start"
  else
    usage_die "bad argument '$arg' (expected N or A-B)"
  fi
  for ((n = lo; n <= hi; n++)); do
    [ -z "${seen[$n]:-}" ] || usage_die "issue #$n specified more than once"
    seen[$n]=1
    ISSUES+=("$n")
  done
done

# ---- Target + logging setup ----
APP_DIR="$PWD"
PROJECT="$(basename "$APP_DIR")"
LOG_DIR="$HOME/.local/state/overnight/$PROJECT/$(date '+%Y-%m-%dT%H-%M-%S')"
RUN_LOG="$LOG_DIR/run.log"

mkdir -p "$LOG_DIR"

log() { printf '%s  %s\n' "$(date '+%F %T')" "$*" | tee -a "$RUN_LOG"; }
die() { log "STOP: $*"; log "=== queue halted — everything preserved for morning review ==="; exit 1; }

tracked_dirty() { [ -n "$(git status --porcelain --untracked-files=no)" ]; }

issue_state() { gh issue view "$1" --json state -q .state; }
issue_url() { gh issue view "$1" --json url -q .url; }

# ---- Wind-down hook (generated per run) ----
# A headless agent can't be messaged mid-run, but PostToolUse hooks can: past
# the soft deadline this hook exits 2 with a nag on stderr, which the harness
# feeds back to the model after EVERY tool call until the agent actually winds
# down. Per-link parameters (start epoch, issue number, handoff path) arrive
# via environment variables exported by the queue loop and inherited by the
# agent process and its hooks. No matcher in the settings entry = all tools.
HOOK_SCRIPT="$LOG_DIR/winddown-hook.sh"
HOOK_SETTINGS="$LOG_DIR/hook-settings.json"

cat >"$HOOK_SCRIPT" <<EOF
#!/usr/bin/env bash
# Generated by overnight — PostToolUse two-stage wind-down nag.
start="\${OVERNIGHT_LINK_START:-}"
[ -n "\$start" ] || exit 0
elapsed=\$(( \$(date +%s) - start ))
[ "\$elapsed" -ge $(( SOFT_DEADLINE_MIN * 60 )) ] || exit 0
mins=\$(( elapsed / 60 ))
left=\$(( ($(( HARD_KILL_MIN * 60 )) - elapsed) / 60 ))
n="\${OVERNIGHT_ISSUE:-?}"
if [ "\$elapsed" -lt $(( ESCALATION_MIN * 60 )) ]; then
  cat >&2 <<MSG
[overnight wind-down] \${mins}m elapsed — past the ${SOFT_DEADLINE_MIN}m soft deadline (hard kill in ~\${left}m). If you can GENUINELY complete issue #\$n — every criterion met, full test suite green, commit, comment, close — within about $(( ESCALATION_MIN - SOFT_DEADLINE_MIN )) minutes, do it now. Otherwise STOP starting new work: commit coherent work as wip(#\$n) checkpoints, write your handoff note to \$OVERNIGHT_HANDOFF_PATH (done / remaining / key commits and files / decisions and why / gotchas / recommended next step), then end your turn. A handoff is success, not failure. If you are a subagent: never write the handoff — finish your delegated task promptly and return to the main agent.
MSG
else
  cat >&2 <<MSG
[overnight wind-down] \${mins}m elapsed — HAND OFF NOW. Do not attempt to finish issue #\$n. Commit your work as wip(#\$n) checkpoints, write the handoff note to \$OVERNIGHT_HANDOFF_PATH, and end your turn immediately — the hard kill lands in ~\${left}m and wastes an attempt. If you are a subagent: return your result to the main agent now; only the top-level agent writes the handoff.
MSG
fi
exit 2
EOF
chmod +x "$HOOK_SCRIPT"

cat >"$HOOK_SETTINGS" <<EOF
{
  "hooks": {
    "PostToolUse": [
      { "hooks": [ { "type": "command", "command": "$HOOK_SCRIPT" } ] }
    ]
  }
}
EOF

# ---- Agent prompts ----
# Three launch reasons, one prompt each:
#   fresh    first link on an issue
#   handoff  successor after a clean handoff (handoff note embedded verbatim)
#   retry    recovery after a failed link (archaeology preamble; latest handoff
#            embedded too if one exists, with a staleness caveat)
# All variants share the chain framing, the task core, the completion rules,
# and the headless/no-background-subagent rules.
agent_prompt() {
  local n="$1" reason="$2" handoff_file="$3" attempt="$4"

  if [ "$reason" = "handoff" ]; then
    cat <<EOF
You are picking up GitHub issue #$n from a previous agent that handed off cleanly mid-work. Its handoff note is below. Treat git history and the issue itself as ground truth — the handoff is a guide, not gospel. Expect wip(#$n) checkpoint commits (they may not have green tests); build on the existing work instead of redoing it.

--- HANDOFF FROM PREVIOUS AGENT ---
$(cat "$handoff_file")
--- END HANDOFF ---

EOF
  elif [ "$reason" = "retry" ]; then
    cat <<EOF
You are picking up GitHub issue #$n from a previous agent that did NOT finish it — it crashed, was hard-killed, or left the type-check/test suite red. This is attempt $attempt of $MAX_ATTEMPTS.

Before anything else, inspect the current state to see what was already done: run \`git log --oneline -20\`, \`git status\`, and \`gh issue view $n --comments\`. The previous agent may have committed partial work and even closed the issue while it was still incomplete or red. If the issue is CLOSED, reopen it with \`gh issue reopen $n\`. Build on the existing work instead of redoing it from scratch, then finish it correctly.

EOF
    if [ -n "$handoff_file" ] && [ -s "$handoff_file" ]; then
      cat <<EOF
The most recent handoff note from this issue's chain is below. It may predate the failed attempt — work may have happened after it was written — so verify it against git before trusting it.

--- MOST RECENT HANDOFF ---
$(cat "$handoff_file")
--- END HANDOFF ---

EOF
    fi
  fi

  cat <<EOF
You are running unattended overnight as one link in a chain of agents working sequentially on this issue. Finishing the issue yourself and handing off to a successor are BOTH success — never rush or skimp on work to avoid a handoff.

Implement GitHub issue #$n using the /implement skill. Read the issue with: gh issue view $n — the issue is your primary source of truth. Verify every acceptance criterion is met, including full test suite and type-check green.

Deadlines and handoff protocol: from $SOFT_DEADLINE_MIN minutes a wind-down notice will arrive after every tool call; at $HARD_KILL_MIN minutes the session is hard-killed, which wastes an attempt — never let it come to that. Work in committable increments from the start so winding down is always cheap. When told to wind down: finish-and-close only if that is genuinely imminent; otherwise commit coherent work as \`wip(#$n): ...\` checkpoints (checkpoints do NOT need green tests), write a handoff note for your successor to $OVERNIGHT_HANDOFF_PATH — what is done, what remains, key commits and files, decisions made and why, gotchas discovered, recommended next step — and end your turn. If a large discrete task (a code review, say) remains near the deadline, leave it to a fresh successor rather than starting it. Never create the handoff file when you are closing the issue — its existence tells the runner the issue is being handed off unfinished.

When done for real: commit your work. Then — always, on every run, no matter what — run the FULL test suite yourself (npm test) after the commit and confirm it is green, to be certain the commit got everything correct. Only once the full suite passes, post a comment on issue #$n stating what action is required on prod, then close the issue. Closing the issue is the signal that unblocks the next queued issue — only close when genuinely complete and the full suite is green.

You run headless: when you end a turn, the session is over. Never end a turn with a background subagent still running — the harness kills it and you never re-wake to finish, leaving the issue OPEN with work uncommitted. So run any subagent whose output the final gates depend on synchronously (run_in_background: false) and wait for it, and never delegate the terminal steps (final full test suite, commit, close, or the handoff note) to a background subagent — do those yourself, in one active turn, only after every subagent has returned.
EOF

  if [ "$HUMAN" -eq 1 ]; then
    cat <<EOF

No human is available to answer questions mid-run, so never ask — decide and proceed. Only if you are genuinely blocked and cannot proceed without human input: post a comment on issue #$n explaining exactly what you need and why you stopped, leave the issue OPEN, do NOT write a handoff file, and end your session. Do not close an issue whose work is incomplete.
EOF
  else
    cat <<EOF

No human is available and you must NEVER stop to ask for input or leave the issue OPEN pending a human decision. Whenever you hit ambiguity or a design choice, ground it in the surrounding work: read this issue's linked/referenced issues, run \`gh issue list\` and \`gh issue view\` on the issues it mentions or that mention it, and infer the philosophy and direction those issues express. Choose the solution that best fits that philosophy, then decide and proceed. If the work truly cannot finish in your session, hand off — the chain continues.
EOF
  fi
}

log "logs: $LOG_DIR"
log "=== overnight run starting in $APP_DIR: issues ${ISSUES[*]} ==="
[ "$HUMAN" -eq 1 ] && log "mode: --human (a blocked agent may leave an issue OPEN and halt the queue)" \
                   || log "mode: autonomous (agents decide everything themselves)"

# ---- Pre-flight ----
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "pre-flight: $APP_DIR is not inside a git repository"
[ -f "$APP_DIR/package.json" ] || die "pre-flight: no package.json in $APP_DIR"
gh auth status >/dev/null 2>&1 || die "pre-flight: gh auth status failed"
command -v jq >/dev/null 2>&1 || die "pre-flight: jq not on PATH"

# `claude` on PATH is normally a per-account wrapper that would override the
# CLAUDE_CONFIG_DIR resolved above — use the first claude OUTSIDE the wrapper
# dir (the real binary).
CLAUDE_BIN=""
while IFS= read -r p; do
  case "$p" in "$HOME/.local/claude-bin/"*) continue ;; esac
  CLAUDE_BIN="$p"; break
done < <(type -ap claude)
[ -n "$CLAUDE_BIN" ] || die "pre-flight: no claude binary on PATH (outside ~/.local/claude-bin)"

ACCOUNT_EMAIL="$(jq -r '.oauthAccount.emailAddress // empty' "$CONFIG_JSON" 2>/dev/null)"
[ -n "$ACCOUNT_EMAIL" ] || die "pre-flight: no logged-in account in $CONFIG_JSON — run: CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR claude, then /login"
log "account: $ACCOUNT_EMAIL ($CONFIG_DESC)"

for n in "${ISSUES[@]}"; do
  state="$(issue_state "$n")" || die "pre-flight: cannot read issue #$n (nonexistent, or a PR?)"
  [ "$state" = "OPEN" ] || die "pre-flight: issue #$n is $state, expected OPEN"
  url="$(issue_url "$n")" || die "pre-flight: cannot read issue #$n URL"
  case "$url" in
    */issues/*) ;;
    *) die "pre-flight: #$n is not an issue ($url)" ;;
  esac
done

tracked_dirty && die "pre-flight: tracked working tree is not clean"

log "pre-flight: type-check"
npm run type-check >"$LOG_DIR/preflight-typecheck.log" 2>&1 || die "pre-flight: baseline type-check red (see preflight-typecheck.log)"
log "pre-flight: full test suite"
npm test >"$LOG_DIR/preflight-test.log" 2>&1 || die "pre-flight: baseline tests red (see preflight-test.log)"
log "pre-flight passed"

# ---- Queue ----
# Per issue: launch links until the issue closes with green gates. Exit
# classification, in order: done (CLOSED + green gates) > planned handoff
# (clean exit + handoff note at THIS link's path) > blocked-for-human
# (--human only) > failure. A handoff resets the consecutive-failure counter;
# a failure bumps it and relaunches with the archaeology prompt. The budget is
# checked before each launch, never mid-link.
for n in "${ISSUES[@]}"; do
  issue_start=$(date +%s)
  link=0
  consec_fail=0
  fast_fail=0
  last_handoff=""
  reason="fresh"
  issue_done=0

  while :; do
    if [ $(( $(date +%s) - issue_start )) -ge $(( ISSUE_BUDGET_MIN * 60 )) ]; then
      die "issue #$n: ${ISSUE_BUDGET_MIN}m budget exhausted after $link links${last_handoff:+ — latest handoff: $(basename "$last_handoff")}"
    fi

    link=$((link + 1))
    handoff_path="$LOG_DIR/issue-$n-link-$link-handoff.md"
    logfile="$LOG_DIR/issue-$n-link-$link.log"

    case "$reason" in
      fresh)   log "--- issue #$n link $link: fresh agent (soft ${SOFT_DEADLINE_MIN}m, hard ${HARD_KILL_MIN}m) ---" ;;
      handoff) log "--- issue #$n link $link: successor picks up $(basename "$last_handoff") ---" ;;
      retry)   log "--- issue #$n link $link: retry after failure ($consec_fail/$MAX_ATTEMPTS consecutive) ---" ;;
    esac

    export OVERNIGHT_LINK_START="$(date +%s)"
    export OVERNIGHT_ISSUE="$n"
    export OVERNIGHT_HANDOFF_PATH="$handoff_path"

    link_t0=$(date +%s)
    timeout --kill-after=2m "${HARD_KILL_MIN}m" \
      "$CLAUDE_BIN" -p "$(agent_prompt "$n" "$reason" "$last_handoff" "$((consec_fail + 1))")" \
      --dangerously-skip-permissions --settings "$HOOK_SETTINGS" \
      >"$logfile" 2>&1 </dev/null
    rc=$?
    link_secs=$(( $(date +%s) - link_t0 ))

    if [ "$rc" -eq 0 ]; then
      state="$(issue_state "$n")" || die "issue #$n: cannot read issue state after link $link"
      if [ "$state" = "CLOSED" ]; then
        if tracked_dirty; then
          log "issue #$n link $link: closed the issue but left the tracked tree dirty"
        else
          log "issue #$n link $link: gate type-check"
          if ! npm run type-check >"$LOG_DIR/issue-$n-link-$link-gate-typecheck.log" 2>&1; then
            log "issue #$n link $link: type-check red after close (see issue-$n-link-$link-gate-typecheck.log)"
          else
            log "issue #$n link $link: gate full test suite"
            if ! npm test >"$LOG_DIR/issue-$n-link-$link-gate-test.log" 2>&1; then
              log "issue #$n link $link: tests red after close (see issue-$n-link-$link-gate-test.log)"
            else
              log "issue #$n: complete on link $link, all gates green — $(git log -1 --oneline)"
              issue_done=1
              break
            fi
          fi
        fi
      elif [ -s "$handoff_path" ]; then
        log "issue #$n link $link: handed off after $((link_secs / 60))m ($(basename "$handoff_path"))"
        last_handoff="$handoff_path"
        consec_fail=0
        fast_fail=0
        reason="handoff"
        continue
      elif [ "$HUMAN" -eq 1 ]; then
        die "issue #$n: left OPEN by link $link for human input — read its issue comment and $(basename "$logfile")"
      else
        log "issue #$n link $link: exited cleanly but left the issue OPEN with no handoff (see $(basename "$logfile"))"
      fi
    elif [ "$rc" -eq 124 ]; then
      log "issue #$n link $link: hit the ${HARD_KILL_MIN}m hard kill — wind-down ignored (see $(basename "$logfile"); tree may hold partial work)"
    else
      log "issue #$n link $link: claude exited $rc after $((link_secs / 60))m (see $(basename "$logfile"))"
    fi

    # -- this link failed --
    # A handoff written before the death still informs the retry prompt.
    [ -s "$handoff_path" ] && last_handoff="$handoff_path"

    if [ "$rc" -ne 0 ] && [ "$rc" -ne 124 ] && [ "$link_secs" -lt "$FAST_FAIL_SECS" ]; then
      fast_fail=$((fast_fail + 1))
      if [ "$fast_fail" -ge 2 ]; then
        die "issue #$n: two consecutive links died within ${FAST_FAIL_SECS}s — systemic failure (out of tokens? auth? environment?), not an issue failure. See $(basename "$logfile")."
      fi
    else
      fast_fail=0
    fi

    consec_fail=$((consec_fail + 1))
    if [ "$consec_fail" -ge "$MAX_ATTEMPTS" ]; then
      die "issue #$n: $MAX_ATTEMPTS consecutive failed links — read the issue comments and the issue-$n-link-*.log files"
    fi
    reason="retry"
  done

  [ "$issue_done" -eq 1 ] || die "issue #$n: chain ended without completion"
done

log "=== overnight run complete: all ${#ISSUES[@]} issues closed, tests green. Review commits, then push. ==="
