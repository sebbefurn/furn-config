#!/usr/bin/env bash
# overnight — unattended sequential issue runner.
#
# Runs a Claude agent per GitHub issue in the current project, gating each
# issue on: agent exit 0, issue CLOSED, clean tracked tree, type-check, tests.
# A failed or timed-out attempt is retried (up to MAX_ATTEMPTS) by a fresh agent
# that picks up the previous one's unfinished work; only after the attempts are
# exhausted does the queue halt, preserving everything for review.
#
# Operates on the CURRENT WORKING DIRECTORY (must be a git repo with a
# package.json). Launch with:
#   systemd-inhibit --what=sleep:idle overnight --account sebastian 327-334
# (inside tmux).
#
# --account picks the Claude account the agents spend, by name from
# ~/.config/claude/accounts (see usage below). There is no default: agents
# would otherwise quietly bill whatever account happened to be ambient.
set -u

AGENT_TIMEOUT=60m
# A single issue gets up to this many agent attempts. An attempt that times out,
# exits nonzero, leaves the issue OPEN, or lands with a red gate is not fatal:
# the same issue is relaunched with a fresh agent told to pick up the unfinished
# work. Only after MAX_ATTEMPTS failed attempts does the queue halt.
MAX_ATTEMPTS=3

# Headless (`claude -p`) keeps waiting for background subagents after the model
# ends its turn, up to this ceiling, before terminating the session. The default
# is 600s (10m); a fan-out of test-file subagents can need longer, and being
# killed mid-wait strands the run — the agent never re-wakes to run the final
# suite/commit/close, so the issue is left OPEN with work uncommitted. 15 minutes.
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=900000

usage() {
  cat <<'EOF'
usage: overnight --account <name> [--no-human] <issue|start-end> [...]

Each positional argument is a single issue number or an inclusive range
(end >= start). Any mix is allowed; the queue runs in the order given,
ranges ascending.

--account selects which Claude account the agents spend, by account name
from the ~/.config/claude/accounts manifest (config dir ~/.claude-<name>).
It is required unless CLAUDE_CONFIG_DIR is already set in the environment,
in which case that dir is inherited. The resolved account's email is
logged at pre-flight, before any agent runs.

--no-human runs fully autonomously: an agent never stops to ask for human
input or leaves an issue OPEN pending a decision. On any ambiguity it reads
the related and linked issues, infers the philosophy they express, and picks
the best-fitting solution itself. Without this flag, an agent that is
genuinely blocked may post a comment and leave the issue OPEN for review.

Each issue gets up to 3 agent attempts: an attempt that times out (60m),
exits nonzero, leaves the issue OPEN, or lands with a red type-check/test
gate is retried by a fresh agent that picks up the unfinished work. The
queue halts only after all 3 attempts on an issue fail.

examples:
  overnight --account sebastian 327-334
  overnight --account sebbe --no-human 1 2 4 10
  overnight --account sebastian 4-6 8-15 17 20-21

Runs against the current directory: pre-flight requires a git repo with
package.json, gh auth, claude on PATH, a logged-in account config dir, all
issues OPEN, a clean tracked tree, and green `npm run type-check` +
`npm test` before any agent starts.
Logs land in ~/.local/state/overnight/<dir-name>/<timestamp>/.
EOF
}

usage_die() { printf 'overnight: %s\n\n' "$*" >&2; usage >&2; exit 2; }

# ---- Argument parsing (no side effects until args are fully valid) ----
[ $# -gt 0 ] || usage_die "no issues specified"

ACCOUNT=""
NO_HUMAN=0
POSITIONAL=()
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --account)
      [ $# -ge 2 ] || usage_die "--account needs a value (an account name from ~/.config/claude/accounts)"
      ACCOUNT="$2"; shift 2 ;;
    --account=*) ACCOUNT="${1#*=}"; shift ;;
    --no-human) NO_HUMAN=1; shift ;;
    -*) usage_die "unknown option '$1'" ;;
    *) POSITIONAL+=("$1"); shift ;;
  esac
done

# Account -> config dir. Explicit flag (validated against the manifest) wins;
# otherwise inherit an already-set CLAUDE_CONFIG_DIR; otherwise refuse rather
# than silently spend an account.
ACCOUNTS_FILE="$HOME/.config/claude/accounts"
known_accounts() { awk '!/^([[:space:]]*(#|$))/ { print $2 }' "$ACCOUNTS_FILE" 2>/dev/null; }

if [ -n "$ACCOUNT" ]; then
  known_accounts | grep -qx -- "$ACCOUNT" \
    || usage_die "unknown account '$ACCOUNT' (known, from $ACCOUNTS_FILE: $(known_accounts | paste -sd' ' -))"
  export CLAUDE_CONFIG_DIR="$HOME/.claude-$ACCOUNT"
  CONFIG_DESC="$CLAUDE_CONFIG_DIR"
else
  [ -n "${CLAUDE_CONFIG_DIR:-}" ] \
    || usage_die "no account selected: pass --account <name> (known, from $ACCOUNTS_FILE: $(known_accounts | paste -sd' ' -))"
  export CLAUDE_CONFIG_DIR
  CONFIG_DESC="$CLAUDE_CONFIG_DIR (inherited)"
fi
CONFIG_JSON="$CLAUDE_CONFIG_DIR/.claude.json"

[ ${#POSITIONAL[@]} -gt 0 ] || usage_die "no issues specified"

ISSUES=()
declare -A seen=()
for arg in "${POSITIONAL[@]}"; do
  if [[ "$arg" =~ ^[0-9]+$ ]]; then
    lo=$((10#$arg)) hi=$((10#$arg))
  elif [[ "$arg" =~ ^([0-9]+)-([0-9]+)$ ]]; then
    lo=$((10#${BASH_REMATCH[1]})) hi=$((10#${BASH_REMATCH[2]}))
    [ "$hi" -ge "$lo" ] || usage_die "range '$arg': end must be >= start"
  else
    usage_die "bad argument '$arg' (expected N or A-B)"
  fi
  for ((n = lo; n <= hi; n++)); do
    [ -z "${seen[$n]:-}" ] || usage_die "issue #$n specified more than once"
    seen[$n]=1
    ISSUES+=("$n")
  done
done

# ---- Target + logging setup ----
APP_DIR="$PWD"
PROJECT="$(basename "$APP_DIR")"
LOG_DIR="$HOME/.local/state/overnight/$PROJECT/$(date '+%Y-%m-%dT%H-%M-%S')"
RUN_LOG="$LOG_DIR/run.log"

mkdir -p "$LOG_DIR"

log() { printf '%s  %s\n' "$(date '+%F %T')" "$*" | tee -a "$RUN_LOG"; }
die() { log "STOP: $*"; log "=== queue halted — everything preserved for morning review ==="; exit 1; }

tracked_dirty() { [ -n "$(git status --porcelain --untracked-files=no)" ]; }

issue_state() { gh issue view "$1" --json state -q .state; }
issue_url() { gh issue view "$1" --json url -q .url; }

agent_prompt() {
  local n="$1" attempt="$2"

  # Retry attempts (2..MAX_ATTEMPTS) lead with a pick-up preamble so the fresh
  # agent builds on whatever the previous one left, rather than starting over.
  if [ "$attempt" -gt 1 ]; then
    cat <<EOF
You are picking up GitHub issue #$n from a previous agent that did NOT finish it — it timed out, exited early, or left the type-check/test suite red. This is attempt $attempt of $MAX_ATTEMPTS.

Before anything else, inspect the current state to see what was already done: run \`git log --oneline -20\`, \`git status\`, and \`gh issue view $n --comments\`. The previous agent may have committed partial work and even closed the issue while it was still incomplete or red. If the issue is CLOSED, reopen it with \`gh issue reopen $n\`. Build on the existing work instead of redoing it from scratch, then finish it correctly.

EOF
  fi

  cat <<EOF
You are running unattended overnight as part of an automated queue.

Implement GitHub issue #$n using the /implement skill. Read the issue with: gh issue view $n. Verify every acceptance criterion is met, including full test suite and type-check green.

When done: commit your work. Then — always, on every run, no matter what — run the FULL test suite yourself (npm test) after the commit and confirm it is green, to be certain the commit got everything correct. Only once the full suite passes, post a comment on issue #$n stating what action is required on prod, then close the issue. Closing the issue is the signal that unblocks the next queued issue — only close when genuinely complete and the full suite is green.

You run headless: when you end a turn, the session is over. Never end a turn with a background subagent still running — the harness kills it and you never re-wake to finish, leaving the issue OPEN with work uncommitted and the whole queue halted. So run any subagent whose output the final gates depend on synchronously (run_in_background: false) and wait for it, and never delegate the terminal steps (final full test suite, commit, close) to a background subagent — do those yourself, in one active turn, only after every subagent has returned.
EOF

  if [ "$NO_HUMAN" -eq 1 ]; then
    cat <<EOF

No human is available and you must NEVER stop to ask for input or leave the issue OPEN pending a human decision. Whenever you hit ambiguity or a design choice, ground it in the surrounding work: read this issue's linked/referenced issues, run \`gh issue list\` and \`gh issue view\` on the issues it mentions or that mention it, and infer the philosophy and direction those issues express. Choose the solution that best fits that philosophy, then decide and proceed. There is no escape hatch — finish the work.
EOF
  else
    cat <<EOF

No human is available to answer questions mid-run, so never ask — decide and proceed. Only if you are genuinely blocked and cannot proceed without human input: post a comment on issue #$n explaining exactly what you need and why you stopped, leave the issue OPEN, and end your session. Do not close an issue whose work is incomplete.
EOF
  fi
}

log "logs: $LOG_DIR"
log "=== overnight run starting in $APP_DIR: issues ${ISSUES[*]} ==="

# ---- Pre-flight ----
git rev-parse --is-inside-work-tree >/dev/null 2>&1 || die "pre-flight: $APP_DIR is not inside a git repository"
[ -f "$APP_DIR/package.json" ] || die "pre-flight: no package.json in $APP_DIR"
gh auth status >/dev/null 2>&1 || die "pre-flight: gh auth status failed"
command -v jq >/dev/null 2>&1 || die "pre-flight: jq not on PATH"

# `claude` on PATH is normally a per-account wrapper that would override the
# CLAUDE_CONFIG_DIR resolved above — use the first claude OUTSIDE the wrapper
# dir (the real binary).
CLAUDE_BIN=""
while IFS= read -r p; do
  case "$p" in "$HOME/.local/claude-bin/"*) continue ;; esac
  CLAUDE_BIN="$p"; break
done < <(type -ap claude)
[ -n "$CLAUDE_BIN" ] || die "pre-flight: no claude binary on PATH (outside ~/.local/claude-bin)"

ACCOUNT_EMAIL="$(jq -r '.oauthAccount.emailAddress // empty' "$CONFIG_JSON" 2>/dev/null)"
[ -n "$ACCOUNT_EMAIL" ] || die "pre-flight: no logged-in account in $CONFIG_JSON — run: CLAUDE_CONFIG_DIR=$CLAUDE_CONFIG_DIR claude, then /login"
log "account: $ACCOUNT_EMAIL ($CONFIG_DESC)"

for n in "${ISSUES[@]}"; do
  state="$(issue_state "$n")" || die "pre-flight: cannot read issue #$n (nonexistent, or a PR?)"
  [ "$state" = "OPEN" ] || die "pre-flight: issue #$n is $state, expected OPEN"
  url="$(issue_url "$n")" || die "pre-flight: cannot read issue #$n URL"
  case "$url" in
    */issues/*) ;;
    *) die "pre-flight: #$n is not an issue ($url)" ;;
  esac
done

tracked_dirty && die "pre-flight: tracked working tree is not clean"

log "pre-flight: type-check"
npm run type-check >"$LOG_DIR/preflight-typecheck.log" 2>&1 || die "pre-flight: baseline type-check red (see preflight-typecheck.log)"
log "pre-flight: full test suite"
npm test >"$LOG_DIR/preflight-test.log" 2>&1 || die "pre-flight: baseline tests red (see preflight-test.log)"
log "pre-flight passed"

# ---- Queue ----
# Each issue gets up to MAX_ATTEMPTS agent attempts. Any attempt that fails a
# gate (timeout, nonzero exit, issue left OPEN, dirty tree, red type-check/test)
# is not fatal on its own: a fresh agent is relaunched to pick up the unfinished
# work. The queue halts only when an issue exhausts all its attempts.
for n in "${ISSUES[@]}"; do
  issue_done=0
  for ((attempt = 1; attempt <= MAX_ATTEMPTS; attempt++)); do
    if [ "$attempt" -eq 1 ]; then
      log "--- issue #$n: launching agent (attempt $attempt/$MAX_ATTEMPTS, cap $AGENT_TIMEOUT) ---"
    else
      log "--- issue #$n: retry — fresh agent picks up unfinished work (attempt $attempt/$MAX_ATTEMPTS, cap $AGENT_TIMEOUT) ---"
    fi

    logfile="$LOG_DIR/issue-$n-attempt-$attempt.log"
    timeout --kill-after=2m "$AGENT_TIMEOUT" \
      "$CLAUDE_BIN" -p "$(agent_prompt "$n" "$attempt")" --dangerously-skip-permissions \
      >"$logfile" 2>&1 </dev/null
    rc=$?

    if [ "$rc" -eq 124 ]; then
      log "issue #$n: attempt $attempt hit the $AGENT_TIMEOUT timeout (see $(basename "$logfile"); tree may hold partial work)"
      continue
    fi
    if [ "$rc" -ne 0 ]; then
      log "issue #$n: attempt $attempt — claude exited $rc (see $(basename "$logfile"))"
      continue
    fi

    state="$(issue_state "$n")" || die "issue #$n: cannot read issue state after agent exit"
    if [ "$state" != "CLOSED" ]; then
      # In --no-human mode an agent must never leave an issue OPEN, so treat it
      # as unfinished work and retry. Without the flag, an OPEN issue means the
      # agent deliberately stopped for human input — halt so a human can look.
      if [ "$NO_HUMAN" -eq 1 ]; then
        log "issue #$n: attempt $attempt left the issue OPEN (read its issue comment and $(basename "$logfile"))"
        continue
      fi
      die "issue #$n: left OPEN by agent — read its issue comment and $(basename "$logfile")"
    fi

    if tracked_dirty; then
      log "issue #$n: attempt $attempt closed the issue but left the tracked tree dirty"
      continue
    fi

    log "issue #$n: attempt $attempt gate type-check"
    if ! npm run type-check >"$LOG_DIR/issue-$n-attempt-$attempt-gate-typecheck.log" 2>&1; then
      log "issue #$n: attempt $attempt — type-check red after close (see issue-$n-attempt-$attempt-gate-typecheck.log)"
      continue
    fi
    log "issue #$n: attempt $attempt gate full test suite"
    if ! npm test >"$LOG_DIR/issue-$n-attempt-$attempt-gate-test.log" 2>&1; then
      log "issue #$n: attempt $attempt — tests red after close (see issue-$n-attempt-$attempt-gate-test.log)"
      continue
    fi

    log "issue #$n: all gates green on attempt $attempt — $(git log -1 --oneline)"
    issue_done=1
    break
  done

  [ "$issue_done" -eq 1 ] || die "issue #$n: still not complete after $MAX_ATTEMPTS attempts — read its issue comments and the issue-$n-attempt-*.log files"
done

log "=== overnight run complete: all ${#ISSUES[@]} issues closed, tests green. Review commits, then push. ==="
