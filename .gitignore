# --- Vim runtime (created at use-time, never tracked) ---
stow/vim/.vim/undo/
stow/vim/.vim/backup/
stow/vim/.vim/swap/

# --- Claude Code secrets / runtime (backstop; these live in ~/.claude) ---
**/.claude/.credentials.json
**/.claude/settings.local.json
**/.claude/projects/
**/.claude/sessions/
**/.claude/plans/
**/.claude/history.jsonl
**/.claude/shell-snapshots/
**/.claude/cache/
**/.claude/backups/
**/.claude/file-history/
**/.claude/downloads/
**/.claude/session-env/
**/.claude/plugins/

# --- Private keys must NEVER be committed ---
*id_ed25519
*id_rsa
*.pem
*.key

# --- OS / editor cruft ---
.DS_Store
*.swp
*~
